# --- Telegram ---
# Create via @BotFather, then /setprivacy -> Disabled (so bot sees group messages)
TELEGRAM_BOT_TOKEN=0000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# The group chat id where proposals are coordinated. Get by running bot and typing /chatid in the group.
TELEGRAM_GROUP_CHAT_ID=-1000000000000

# --- Zerion ---
# https://dashboard.zerion.io -> generate API key
ZERION_API_KEY=zk_xxx
# Agent token created via `zerion agent create-token --name treasury-bot --wallet consensus-treasury`
ZERION_AGENT_TOKEN=zat_xxx
# Wallet name passed to `zerion swap --wallet <name>` (OWS passphrase must be cached or in ZERION_WALLET_PASSPHRASE)
ZERION_WALLET=consensus-treasury
ZERION_WALLET_PASSPHRASE=

# --- Consensus ---
# Absolute path; defaults to $HOME/.consensus
CONSENSUS_STATE_DIR=
# Proposal time-to-live in seconds before auto-expiry
CONSENSUS_PROPOSAL_TTL=3600
